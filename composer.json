{
    "name": "al3x5/xbot",
    "description": "Build powerful Telegram bots with ease",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "bot",
        "telegram-bot",
        "telegram-api",
        "webhook",
        "framework"
    ],
    "homepage": "https://github.com/al3x5dev/xbot",
    "authors": [
        {
            "name": "al3x5dev",
            "email": "al3x5.dev@gmail.com",
            "homepage": "https://t.me/al3x5dev"
        }
    ],
    "support": {
        "issues": "https://github.com/al3x5dev/xbot/issues",
        "source": "https://github.com/al3x5dev/xbot"
    },
    "require": {
        "php": ">=8.2",
        "mk4u/http": "*",
        "monolog/monolog": "*",
        "mk4u/cache": "*",
        "symfony/console": "*"
    },
    "require-dev": {
        "al3x5/xbot-devkit": "*",
        "symfony/var-dumper": "*",
        "phpunit/phpunit": "*"
    },
    "autoload": {
        "psr-4": {
            "Al3x5\\xBot\\": "src/",
            "Bot\\": "bot/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "bin": [
        "xbot"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
